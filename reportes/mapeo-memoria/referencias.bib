% pp. 1063-1076) y sobre el resumen del artículo.
@article{smith1987,
  author  = {Smith, Alan Jay},
  title   = {Line (Block) Size Choice for {CPU} Cache Memories},
  journal = {IEEE Transactions on Computers},
  volume  = {36},
  number  = {9},
  pages   = {1063--1076},
  month   = sep,
  year    = {1987},
  doi     = {10.1109/TC.1987.5009537},
  note    = {resumen y sección I (Introduction): el tamaño de línea (bloque) es uno de los parámetros que más afecta al rendimiento de la caché, con el compromiso entre localidad espacial y penalización de un fallo al traer bytes no usados; DOI: 10.1109/TC.1987.5009537}
}

% Modelo de conjunto de trabajo (working set) y localidad formal:
% respaldo teórico del análisis de la traza y del thrashing.
% Ubicación verificada sobre el texto del artículo (PDF de ACM).
@article{denning1968,
  author  = {Denning, Peter J.},
  title   = {The Working Set Model for Program Behavior},
  journal = {Communications of the ACM},
  volume  = {11},
  number  = {5},
  pages   = {323--333},
  month   = may,
  year    = {1968},
  doi     = {10.1145/363095.363141},
  note    = {sección 3 ``The Working Set Model'': definición del conjunto de trabajo $W(t,\tau)$ como la colección de páginas referenciadas en el intervalo $(t-\tau, t)$ (fórmula 1) y sección 4 ``Memory Allocation''; DOI: 10.1145/363095.363141}
}

% Propiedades formales del modelo de conjunto de trabajo: el marco
% teórico de por qué el thrashing aparece cuando el conjunto de
% trabajo no cabe. Ubicación verificada en ACM Digital Library
% (CACM vol. 15, núm. 3, marzo 1972, pp. 191-198).
@article{denning1972,
  author  = {Denning, Peter J. and Schwartz, Stuart C.},
  title   = {Properties of the Working-Set Model},
  journal = {Communications of the ACM},
  volume  = {15},
  number  = {3},
  pages   = {191--198},
  month   = mar,
  year    = {1972},
  doi     = {10.1145/361268.361281},
  note    = {desarrollo matemático del modelo de conjunto de trabajo: propiedades del conjunto de trabajo y su relación con el comportamiento de los programas en memoria virtual; DOI: 10.1145/361268.361281}
}

% Anomalía de Belady: referencia clásica del reemplazo (por qué FIFO
% puede ser peor que LRU). Ubicación verificada en ACM Digital Library
% (FJCC 1969, pp. 355-362).
@article{belady1969,
  author  = {Bel\'{a}dy, L\'{a}szl\'{o} A.},
  title   = {An Anomaly in Space-Time Characteristics of Certain Programs Running in a Paging Machine},
  journal = {Proceedings of the AFIPS Fall Joint Computer Conference},
  volume  = {36},
  pages   = {355--362},
  year    = {1969},
  doi     = {10.1145/363011.363155},
  note    = {el tiempo de ejecución de un programa en una máquina con paginación no siempre crece al reducir el almacén disponible: la política FIFO puede empeorar al añadir marcos (anomalía de Belady), motivo por el que se prefieren políticas como LRU; DOI: 10.1145/363011.363155}
}

% Localidad espacial y bloqueo de bucles: respaldo del matiz de que un
% bloque de una sola palabra no aprovecha la localidad espacial.
% Ubicación verificada en ACM Digital Library (ASPLOS IV, abril 1991,
% pp. 63-74) y sobre el resumen del artículo.
@article{lam1991,
  author  = {Lam, Monica S. and Rothberg, Edward E. and Wolf, Michael E.},
  title   = {The Cache Performance and Optimizations of Blocked Algorithms},
  journal = {ACM SIGPLAN Notices},
  volume  = {26},
  number  = {4},
  pages   = {63--74},
  month   = apr,
  year    = {1991},
  doi     = {10.1145/106972.106981},
  note    = {resumen y sección 1: datos de rendimiento de caché de programas bloqueados; el bloqueo reorganiza los cálculos para que aprovechen la localidad espacial, que es lo que un bloque de una sola palabra no puede explotar; DOI: 10.1145/106972.106981}
}

