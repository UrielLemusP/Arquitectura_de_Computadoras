% Survey clásico de la memoria caché: los tres mapeos, política de
% reemplazo y thrashing. Ubicación verificada en ACM Digital Library
% (vol. 14, núm. 3, sept. 1982, pp. 473-530) y sobre el texto del
% artículo (PDF de acceso abierto).
@article{smith1982,
  author  = {Smith, Alan Jay},
  title   = {Cache Memories},
  journal = {ACM Computing Surveys},
  volume  = {14},
  number  = {3},
  pages   = {473--530},
  month   = sep,
  year    = {1982},
  doi     = {10.1145/356887.356892},
  note    = {sección 2 ``Cache Memories'' con las subsecciones sobre las funciones de mapeo (directo, asociativo y por conjuntos), la discusión de \emph{thrashing} como consecuencia de los conflictos de mapeo directo y la relación entre tasa de aciertos y parámetros de la caché; DOI: 10.1145/356887.356892, ISSN: 0360-0300}
}

% Elección del tamaño de bloque: respaldo del matiz de bloques de una
% sola palabra discutido en Resultados. Ubicación verificada en ACM
